# Form delivery for /api/forms (Contact, Careers, Vendor, PDF downloads).
# Configure at least one. With neither set, forms tell visitors the message
# could not be sent — they never show a false success.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
FORMS_TO_EMAIL=hello@HrMagix.com
# Must be a sender on a domain verified in Resend.
FORMS_FROM_EMAIL=HRMagix Website <forms@hrmagix.com>

# Option B: JSON POST to a CRM, Zapier/Make hook, Slack workflow, etc.
FORMS_WEBHOOK_URL=
